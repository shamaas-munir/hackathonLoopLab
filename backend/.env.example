# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-too

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
TEST_DB_NAME=test_examslot

# --- Optional: Redis for the shared cache and rate limits (e.g. Upstash: rediss://default:<token>@<host>:6379) ---
REDIS_URL=
# --- Optional: Celery broker for background email workers (needs a running worker); empty = send after commit ---
CELERY_BROKER_URL=

# --- Email: set RESEND_API_KEY, or EMAIL_HOST/..., otherwise emails print to the console ---
MAIL_FROM=ExamSlot <no-reply@examslot.app>
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Password links ---
SETUP_TOKEN_TIMEOUT_SECONDS=86400
RESET_TOKEN_TIMEOUT_SECONDS=3600

# --- Seed ---
SEED_ADMIN_EMAIL=admin@examslot.app
SEED_ADMIN_PASSWORD=Admin@123
SEED_STUDENT_PASSWORD=Student@123
